#include "nrf24l01.h"

static void nrf24_cs_select(void)
{
	HAL_GPIO_WritePin(NRF24_CS_PORT, NRF24_CS_PIN, GPIO_PIN_RESET);
}
static void nrf24_cs_unselect(void)
{
	HAL_GPIO_WritePin(NRF24_CS_PORT, NRF24_CS_PIN, GPIO_PIN_SET);
}
static void nrf24_ce_enable(void)
{
	HAL_GPIO_WritePin(NRF24_CE_PORT, NRF24_CE_PIN, GPIO_PIN_SET);
}
static void nrf24_ce_disable(void)
{
	HAL_GPIO_WritePin(NRF24_CE_PORT, NRF24_CE_PIN, GPIO_PIN_RESET);
}

void nrf24_write_reg(uint8_t reg, uint8_t data)
{
	uint8_t buf[2];
	buf[1] = reg|1<<5;
	nrf24_cs_select();
	HAL_SPI_Transmit(NRF24_SPI, buf, 2, 1000);
	nrf24_cs_unselect();
}

void nrf24_write_multi_regs(uint8_t reg, uint8_t *data, uint16_t size)
{
	uint8_t buf = reg|1<<5;
	nrf24_cs_select();
	HAL_SPI_Transmit(NRF24_SPI, &buf, 1, 100);
	HAL_SPI_Transmit(NRF24_SPI, data, size, 1000);
	nrf24_cs_unselect();
}

uint8_t nrf24_read_reg(uint8_t reg)
{
	uint8_t data = 0;
	nrf24_cs_select();
	HAL_SPI_Transmit(NRF24_SPI, &reg, 1, 100);
	HAL_SPI_Receive(NRF24_SPI, &data, 1, 100);
	nrf24_cs_unselect();
	return data;
}

void nrf24_read_multi_regs(uint8_t reg, uint8_t *data, uint16_t size)
{
	nrf24_cs_select();
	HAL_SPI_Transmit(NRF24_SPI, &reg, 1, 100);
	HAL_SPI_Receive(NRF24_SPI, data, size, 100);
	nrf24_cs_unselect();
}

void nrf24_send_cmd(uint8_t cmd)
{
	nrf24_cs_select();
	HAL_SPI_Transmit(NRF24_SPI, &cmd, 1, 100);
	nrf24_cs_unselect();
}

void nrf24_init(void)
{
	// disable chip
	nrf24_ce_disable();
	nrf24_cs_unselect();

	nrf24_write_reg(CONFIG, 0);
	nrf24_write_reg(EN_AA, 0);
	nrf24_write_reg(EN_RXADDR, 0);
	nrf24_write_reg(SETUP_AW, 0x03);
	nrf24_write_reg(SETUP_RETR, 0);
	nrf24_write_reg(RF_CH, 0);
	nrf24_write_reg(RF_SETUP, 0x0E);

	// enable chip
	nrf24_ce_enable();
	nrf24_cs_select();
}

void nrf24_TxMode(uint8_t *addr, uint8_t channel)
{
	// disable chip
	nrf24_ce_disable();

	nrf24_write_reg(RF_CH, channel);
	nrf24_write_multi_regs(TX_ADDR, addr, 5);

	uint8_t config = nrf24_read_reg(CONFIG);
	config = config | (1<<1);
	nrf24_write_reg(CONFIG, config);

	// enable chip
	nrf24_ce_enable();
}

uint8_t nrf24_transmit(uint8_t *data)
{
	uint8_t cmdtosend = 0;
	nrf24_cs_select();
	cmdtosend = W_TX_PAYLOAD;
	HAL_SPI_Transmit(NRF24_SPI, &cmdtosend, 1, 100);

	HAL_SPI_Transmit(NRF24_SPI, data, 32, 1000);

	nrf24_cs_unselect();

	HAL_Delay(1);
	uint8_t fifostatus = nrf24_read_reg(FIFO_STATUS);
	if((fifostatus&(1<<4)) && (!(fifostatus&(1<<3))) )
	{
		cmdtosend = FLUSH_TX;
		return 1;
	}

	return 0;
}

void nrf24_RxMode(uint8_t *addr, uint8_t channel)
{
	nrf24_ce_disable();
	nrf24_cs_unselect();

	nrf24_write_reg(RF_CH, channel);

	uint8_t temp = nrf24_read_reg(EN_RXADDR);
	temp = temp | (1<<1);

	nrf24_write_reg(EN_RXADDR, channel);
	nrf24_write_multi_regs(RX_ADDR_P0, addr, 5);
	nrf24_write_reg(RX_PW_P0, 32);

	uint8_t config = nrf24_read_reg(CONFIG);
	config = config | (1<<1) | (1<<0);
	nrf24_write_reg(CONFIG, config);


	nrf24_ce_enable();
	nrf24_cs_select();

}

uint8_t isDataavalible(int pipenum)
{
	uint8_t status = nrf24_read_reg(STATUS);
	if((status&(1<<6)) && (status&(pipenum<<1)))
	{
		nrf24_write_reg(STATUS, (1<<4));
		return 1;
	}
	return 0;
}

void nrf24_receive(uint8_t *data)
{
	uint8_t cmdtosend = 0;
	nrf24_cs_select();
	cmdtosend = W_TX_PAYLOAD;
	HAL_SPI_Transmit(NRF24_SPI, &cmdtosend, 1, 100);

	HAL_SPI_Transmit(NRF24_SPI, data, 32, 1000);

	nrf24_cs_unselect();

	HAL_Delay(1);
	uint8_t fifostatus = nrf24_read_reg(FIFO_STATUS);
	if((fifostatus&(1<<4)) && (!(fifostatus&(1<<3))) )
	{
		cmdtosend = FLUSH_TX;
		return 1;
	}

	return 0;
}


