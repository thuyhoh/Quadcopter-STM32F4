#include "hmc5883l.h"

static uint16_t x_raw, y_raw, z_raw;
static float lsb_per_gause = LSB_per_GAUSS_1090;

void hmc5883l_init(hmc5883l_config_t *config)
{
	uint8_t datatowrite = 0;
	datatowrite =  (config->num_samples<<5)| (config->dataout_rate <<2) | config->mode;
	HAL_I2C_Mem_Read(HMC5883L_I2C, HMC5883L_ADDR, CONFIGA_REG, I2C_MEMADD_SIZE_8BIT, &datatowrite, 1, HAL_MAX_DELAY);

	datatowrite = config->gain<<5;
	HAL_I2C_Mem_Read(HMC5883L_I2C, HMC5883L_ADDR, CONFIGB_REG, I2C_MEMADD_SIZE_8BIT, &datatowrite, 1, HAL_MAX_DELAY);

	datatowrite = config->op_mode;
	HAL_I2C_Mem_Read(HMC5883L_I2C, HMC5883L_ADDR, MODE_REG, I2C_MEMADD_SIZE_8BIT, &datatowrite, 1, HAL_MAX_DELAY);
}

void hmc5883l_read(hmc5884l_val_t *val)
{
	uint8_t data[6];
	HAL_I2C_Mem_Read(HMC5883L_I2C, HMC5883L_ADDR, DATAOUT_REG, I2C_MEMADD_SIZE_8BIT, data, 6, HAL_MAX_DELAY);
	x_raw = (uint16_t)(data[0] << 8 | data[1]);
	x=(float)x_raw/lsb_per_gause;

	y_raw = (uint16_t)(data[2] << 8 | data[3]);
	y=(float)y_raw/lsb_per_gause;

	z_raw = (uint16_t)(data[4] << 8 | data[5]);
	z=(float)z_raw/lsb_per_gause;
}


